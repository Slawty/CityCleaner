    {\n        \"m_SerializableColors\": []\n    },\n    \"m_SourceType\": 1,\n   
    \"m_FunctionName\": \"HitFlash\",\n    \"m_FunctionSource\": \"\",\n    \"m_FunctionSourceUsePragmas\":
    true,\n    \"m_FunctionBody\": \"float age = Time - HitTime; float dur = max(Duration,
    1e-5); float pulse = saturate(1.0 - age / dur); float flicker = 0.5 + 0.5 * sin(Time
    * FlickerHz * 6.28318530718); Flash = pulse * lerp(1.0, flicker, saturate(FlickerBlend)
    * pulse);\"\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.SamplerStateMaterialSlot\",\n   
